<Window x:Class="SentryDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:fl="clr-namespace:FlyleafLib.Controls.WPF;assembly=FlyleafLib"
        xmlns:local="clr-namespace:SentryDeck"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Sentry Deck"
        MinWidth="1200"
        MinHeight="700"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel,
                                         IsDesignTimeCreatable=False}"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered"
        Foreground="{DynamicResource TextControlForeground}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        mc:Ignorable="d">

    <Window.Resources>
        <!--
            Carries the window DataContext into resource-scoped bindings (the grouped clip view)
            and into the re-templated seek bar's overlays, which otherwise can't reach the
            view-model. Defined first so the StaticResource references below resolve.
        -->
        <local:BindingProxy x:Key="VmProxy"
                            Data="{Binding}" />

        <!--  Seek bar: accent played-track, growing thumb, keyboard focus ring, event marker + chunk seams  -->
        <Style x:Key="SeekSlider"
               TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <!--  Not focusable: a keyboard-focused Slider consumes Left/Right/Home/End itself, moving
                  only the thumb (SeekPosition has no seek side effect outside a mouse gesture) and
                  desyncing it from the video. Unfocusable, the keys reach Window_PreviewKeyDown, whose
                  arrow shortcuts issue real 5-second seeks. Mouse seeking is unaffected.  -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!--
                            The transparent background makes the whole bar clickable, since the Track's page buttons below let the mouse through to the event marker.
                        -->
                        <Grid VerticalAlignment="Center"
                              Background="Transparent">
                            <Border x:Name="SeekRail"
                                    Height="4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                    CornerRadius="2" />
                            <Border Height="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="2">
                                <Border.Width>
                                    <MultiBinding Converter="{local:SeekFillWidthConverter}">
                                        <Binding Path="Value"
                                                 RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding ElementName="SeekRail"
                                                 Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>

                            <!--
                                Export selection: a translucent band over the marked in/out range, plus a taller tick at each set mark (each shows on its own, so a lone in-point is visible while placing the out-point).
                                Same offset math as the other overlays; hidden while no marks are set.
                                The band is neutral rather than accent so it still shows over the played fill, which is where it sits after the usual mark, play, mark flow.
                            -->
                            <Border Height="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TextFillColorPrimaryBrush}"
                                    CornerRadius="3"
                                    IsHitTestVisible="False"
                                    Opacity="0.3"
                                    Visibility="{Binding Data.Trim.HasSelection, Converter={local:BoolToVisibilityConverter}, Source={StaticResource VmProxy}}">
                                <Border.Margin>
                                    <MultiBinding Converter="{local:SeekOffsetConverter}">
                                        <Binding Path="Data.Trim.SelectionStartPosition"
                                                 Source="{StaticResource VmProxy}" />
                                        <Binding ElementName="SeekRail"
                                                 Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Margin>
                                <Border.Width>
                                    <MultiBinding Converter="{local:SelectionWidthConverter}">
                                        <Binding Path="Data.Trim.SelectionStartPosition"
                                                 Source="{StaticResource VmProxy}" />
                                        <Binding Path="Data.Trim.SelectionEndPosition"
                                                 Source="{StaticResource VmProxy}" />
                                        <Binding ElementName="SeekRail"
                                                 Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>

                            <Rectangle Width="2"
                                       Height="14"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                       IsHitTestVisible="False"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Visibility="{Binding Data.Trim.HasSelectionStart, Converter={local:BoolToVisibilityConverter}, Source={StaticResource VmProxy}}">
                                <Rectangle.Margin>
                                    <MultiBinding Converter="{local:SeekOffsetConverter}">
                                        <Binding Path="Data.Trim.SelectionStartPosition"
                                                 Source="{StaticResource VmProxy}" />
                                        <Binding ElementName="SeekRail"
                                                 Path="ActualWidth" />
                                    </MultiBinding>
                                </Rectangle.Margin>
                            </Rectangle>

                            <Rectangle Width="2"
                                       Height="14"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                       IsHitTestVisible="False"
                                       RadiusX="1"
                                       RadiusY="1"
                                       Visibility="{Binding Data.Trim.HasSelectionEnd, Converter={local:BoolToVisibilityConverter}, Source={StaticResource VmProxy}}">
                                <Rectangle.Margin>
                                    <MultiBinding Converter="{local:SeekOffsetConverter}">
                                        <Binding Path="Data.Trim.SelectionEndPosition"
                                                 Source="{StaticResource VmProxy}" />
                                        <Binding ElementName="SeekRail"
                                                 Path="ActualWidth" />
                                    </MultiBinding>
                                </Rectangle.Margin>
                            </Rectangle>

                            <!--
                                Chunk seams: faint ~60s boundary ticks. Each tick offsets by
                                fraction × rail width; the ItemsControl matches the rail's width,
                                so ticks stay aligned on resize. Empty list draws nothing.
                            -->
                            <local:DecorativeItemsControl Focusable="False"
                                                          IsHitTestVisible="False"
                                                          ItemsSource="{Binding Data.Playback.ChunkBoundaries, Source={StaticResource VmProxy}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="1"
                                                   Height="8"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Fill="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                   Opacity="0.35">
                                            <Rectangle.Margin>
                                                <MultiBinding Converter="{local:SeekOffsetConverter}">
                                                    <Binding />
                                                    <Binding Path="ActualWidth"
                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Rectangle.Margin>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </local:DecorativeItemsControl>

                            <!--
                                Gap ticks: where the clip's media time skips over a wall-clock gap (deleted/corrupt/excluded chunks, or a Sentry idle period).
                                A gap always falls on a chunk seam, so its tick is taller, wider and brighter than the seam tick it covers; otherwise skipped real time would look like an ordinary seam.
                                Like the event marker, it sits in a wider transparent border, shifted back by its extra half width, so its tooltip is easy to reach.
                                Empty list (no gaps, or media not opened yet) draws nothing.
                            -->
                            <local:DecorativeItemsControl Focusable="False"
                                                          ItemsSource="{Binding Data.Playback.GapPositions, Source={StaticResource VmProxy}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="10"
                                                Height="16"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                ToolTip="Gap in the footage: time skips ahead here">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="-4" />
                                            </Border.RenderTransform>
                                            <Border.Margin>
                                                <MultiBinding Converter="{local:SeekOffsetConverter}">
                                                    <Binding />
                                                    <Binding Path="ActualWidth"
                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Border.Margin>
                                            <Rectangle Width="2"
                                                       Height="12"
                                                       Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                                       RadiusX="1"
                                                       RadiusY="1" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </local:DecorativeItemsControl>

                            <!--
                                Event marker: a reason-colored tick at the moment the incident happened (hover for details; jump via the button or E).
                                The tick sits in a wider transparent border so the tooltip doesn't need pixel-exact aim.
                                That border is shifted left by its extra half width, so the tick stays exactly where the offset puts it.
                            -->
                            <Border Width="11"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTip="{Binding Data.Playback.EventMarkerTooltip, Source={StaticResource VmProxy}}"
                                    Visibility="{Binding Data.Playback.HasEventMarker, Converter={local:BoolToVisibilityConverter}, Source={StaticResource VmProxy}}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-4" />
                                </Border.RenderTransform>
                                <Border.Margin>
                                    <MultiBinding Converter="{local:SeekOffsetConverter}">
                                        <Binding Path="Data.Playback.EventMarkerPosition"
                                                 Source="{StaticResource VmProxy}" />
                                        <Binding ElementName="SeekRail"
                                                 Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Margin>
                                <Border Width="3"
                                        CornerRadius="1.5">
                                    <Border.Style>
                                        <!--  Reason color via DynamicResource (keyed by ReasonKey) so the marker re-colors on a live OS theme switch.  -->
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Data.Library.SelectedClip, Converter={local:ReasonKeyConverter}, Source={StaticResource VmProxy}}"
                                                             Value="sentry">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Data.Library.SelectedClip, Converter={local:ReasonKeyConverter}, Source={StaticResource VmProxy}}"
                                                             Value="honk">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Data.Library.SelectedClip, Converter={local:ReasonKeyConverter}, Source={StaticResource VmProxy}}"
                                                             Value="alert">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Data.Library.SelectedClip, Converter={local:ReasonKeyConverter}, Source={StaticResource VmProxy}}"
                                                             Value="saved">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>

                            <!--
                                The page buttons never act here: IsMoveToPointEnabled turns every press off the thumb into a jump to that point before they see it.
                                They let the mouse through so it can reach the event marker's tooltip underneath them.
                            -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="Transparent"
                                                  Focusable="False"
                                                  IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="Transparent"
                                                  Focusable="False"
                                                  IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <!--
                                        The scale transform lives on the Thumb (not the inner Grid) so it sits in the Slider template's name scope: the hover storyboard below targets ThumbScale by name, which fails across the nested Thumb-template scope.
                                    -->
                                    <Thumb x:Name="Thumb"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Thumb.RenderTransform>
                                            <ScaleTransform x:Name="ThumbScale" />
                                        </Thumb.RenderTransform>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20"
                                                      Height="20"
                                                      Background="Transparent">
                                                    <Ellipse x:Name="FocusRing"
                                                             Width="20"
                                                             Height="20"
                                                             Fill="Transparent"
                                                             Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                                             StrokeThickness="2"
                                                             Visibility="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}, Converter={local:BoolToVisibilityConverter}}" />
                                                    <Ellipse Width="14"
                                                             Height="14"
                                                             Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                             Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                             StrokeThickness="2" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.25"
                                                             Duration="{StaticResource MotionFaster}" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.25"
                                                             Duration="{StaticResource MotionFaster}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="{StaticResource MotionFast}" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="{StaticResource MotionFast}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CameraViewTileButton"
               TargetType="RadioButton">
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TileBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--
                                No scale animation here: these tiles host the live mini-camera previews, and the
                                Flyleaf surface follows the tile's render transform, so scaling would shift the video.
                            -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <!--  A single selected signal: the 2px accent border.  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="TileBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Hyperlink"
               BasedOn="{StaticResource {x:Type Hyperlink}}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="TextDecorations" Value="None" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <!--  Underline on hover so clickability isn't conveyed by color alone.  -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Promo titles sit BELOW the section headers in the hierarchy (BodyStrong, not larger).  -->
        <Style x:Key="ProjectTitleTextBlock"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ProjectDescriptionTextBlock"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextControlPlaceholderForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  About page: section heading inside a card.  -->
        <Style x:Key="AboutSectionHeader"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,22,0,10" />
        </Style>

        <!--  About page: keyboard keycap chip + its label.  -->
        <Style x:Key="Keycap"
               TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="KeycapText"
               TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AboutShortcutLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ClipListTextBlock"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                             Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Metadata is demoted with contrast (semantic brushes), not opacity.  -->
        <Style x:Key="ClipListSecondaryTextBlock"
               TargetType="TextBlock"
               BasedOn="{StaticResource ClipListTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ClipListTertiaryTextBlock"
               TargetType="TextBlock"
               BasedOn="{StaticResource ClipListTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!--  Day-grouped clip view; grouping lives in XAML via the shared VmProxy above.  -->
        <CollectionViewSource x:Key="GroupedClips"
                              Source="{Binding Data.Library.FilteredClips, Source={StaticResource VmProxy}}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription Converter="{local:DateOnlyConverter}"
                                          PropertyName="Timestamp" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!--  Shared clip context menu (Tag on the item = the view-model).  -->
        <ContextMenu x:Key="ClipContextMenu">
            <MenuItem Header="Open clip folder"
                      Command="{Binding PlacementTarget.Tag.Library.OpenClipFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource AppGlyph}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show on map"
                      Command="{Binding PlacementTarget.Tag.Library.ShowOnMapCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xECAF;" Style="{StaticResource AppGlyph}" />
                </MenuItem.Icon>
            </MenuItem>
            <!--  ±30s of front-camera footage around the event moment, stream-copied (no re-encode).  -->
            <MenuItem Header="Save event clip…"
                      Command="{Binding PlacementTarget.Tag.Trim.SaveEventClipCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE792;" Style="{StaticResource AppGlyph}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Copy clip name"
                      Command="{Binding PlacementTarget.Tag.Library.CopyClipNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource AppGlyph}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy timestamp"
                      Command="{Binding PlacementTarget.Tag.Library.CopyTimestampCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource AppGlyph}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy folder path"
                      Command="{Binding PlacementTarget.Tag.Library.CopyClipPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource AppGlyph}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <!--
                Deletes the whole clip folder so the timeline can be tidied in place.
                The header doesn't name the Recycle Bin because a drive that can't recycle the clip deletes it permanently; the confirmation says which one happens.
            -->
            <MenuItem Header="Delete clip…"
                      Command="{Binding PlacementTarget.Tag.Library.DeleteClipCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74D;" Style="{StaticResource AppGlyph}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Window.Triggers>
        <!--  Fade the window in on launch  -->
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid Visibility="{Binding ShowMainContent, Converter={local:BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"
                                  MinWidth="260"
                                  MaxWidth="440" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sidebar (semi-transparent Layer so Mica shows through)  -->
            <Grid Grid.Column="0"
                  Background="{DynamicResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    Search box.
                    The Fluent TextBox supplies its own focus underline and inline clear button, so this chrome stays neutral (no accent outline on focus) and adds no second clear button, only the surrounding pill plus a leading icon.
                -->
                <Border Grid.Row="0"
                        Margin="12,12,12,8"
                        Padding="8,0,2,0"
                        Background="{DynamicResource TextControlBackground}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   Margin="2,0,8,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource AppGlyph}" />

                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding Library.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8,8,8"
                                     VerticalContentAlignment="Center"
                                     FontSize="14"
                                     AutomationProperties.Name="Search clips"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextControlForeground}" />
                            <TextBlock Text="Search clips, places, events…"
                                       Padding="10,8,8,8"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextControlPlaceholderForeground}"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Library.FilterText}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Clip list (day-grouped incident log)  -->
                <ListBox x:Name="ClipListBox"
                         Grid.Row="1"
                         Margin="4,0"
                         Padding="0,0,6,0"
                         AutomationProperties.Name="Clips"
                         Background="Transparent"
                         BorderThickness="0"
                         IsSynchronizedWithCurrentItem="False"
                         ItemsSource="{Binding Source={StaticResource GroupedClips}}"
                         PreviewMouseLeftButtonUp="ClipListBox_PreviewMouseLeftButtonUp"
                         PreviewMouseRightButtonDown="ClipListBox_PreviewMouseRightButtonDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding Library.ListSelection, Mode=TwoWay}"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <!--  Screen readers name a day group by its raw date value ("12/16/2025 12:00:00 AM") and skip its header, so the group takes the header's wording as its name.  -->
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem"
                                       BasedOn="{StaticResource {x:Type GroupItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name, Converter={local:DayGroupHeaderConverter}}" />
                                </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name, Converter={local:DayGroupHeaderConverter}}"
                                               Margin="12,12,8,4"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource AppCaption}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="4,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="ContextMenu" Value="{StaticResource ClipContextMenu}" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <!--  Without a name, screen readers read a row as the clip's raw timestamp and nothing else; this reads what the card shows.  -->
                            <Setter Property="AutomationProperties.Name">
                                <Setter.Value>
                                    <MultiBinding Converter="{local:ClipAutomationNameConverter}">
                                        <Binding Path="Timestamp" />
                                        <Binding Converter="{local:ReasonLabelConverter}" />
                                        <Binding Path="Event.City" />
                                        <Binding Converter="{local:ClipDurationConverter}" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="88">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Reason stripe (hidden when the row is accent-selected)  -->
                                <Rectangle Grid.Column="0"
                                           Width="3"
                                           Margin="0,10"
                                           HorizontalAlignment="Left"
                                           RadiusX="1.5"
                                           RadiusY="1.5">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <!--  Reason color via DynamicResource (keyed by ReasonKey) so the stripe re-colors on a live OS theme switch.  -->
                                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={local:ReasonKeyConverter}}"
                                                             Value="sentry">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={local:ReasonKeyConverter}}"
                                                             Value="honk">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={local:ReasonKeyConverter}}"
                                                             Value="alert">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Converter={local:ReasonKeyConverter}}"
                                                             Value="saved">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </DataTrigger>
                                                <!--  Hidden (not Collapsed) so the 3px column keeps its width and the thumbnail doesn't shift on select.  -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <!--  Thumbnail (with glyph fallback + now-playing marker)  -->
                                <Border Grid.Column="1"
                                        Width="96"
                                        Height="72"
                                        Margin="8,0,0,0"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        ClipToBounds="True"
                                        CornerRadius="4">
                                    <Grid>
                                        <!--  Follows the decoded image rather than the file's presence, so a corrupt or zero-byte thumb.png shows the glyph instead of an empty tile.  -->
                                        <TextBlock Text="&#xE714;"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="22"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource AppGlyph}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source, ElementName=ThumbnailImage}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image x:Name="ThumbnailImage"
                                               Source="{Binding ThumbnailPath, Converter={local:ThumbnailConverter}}"
                                               Stretch="UniformToFill" />
                                        <Border Margin="0,0,4,4"
                                                Padding="4,1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="#C0000000"
                                                CornerRadius="3">
                                            <Border.Visibility>
                                                <MultiBinding Converter="{local:NowPlayingConverter}">
                                                    <Binding />
                                                    <Binding Path="Data.Playback.NowPlayingClip"
                                                             Source="{StaticResource VmProxy}" />
                                                </MultiBinding>
                                            </Border.Visibility>
                                            <TextBlock Text="&#xE768;"
                                                       FontSize="10"
                                                       Foreground="White"
                                                       Style="{StaticResource AppGlyph}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!--  Info: date/time and reason/duration are justified to opposite ends of each row so the layout reads intentionally without middot separators.  -->
                                <Grid Grid.Column="2"
                                      Margin="12,0,8,0"
                                      VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, Converter={local:FriendlyDateConverter}, ConverterParameter=date}"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource ClipListTextBlock}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Timestamp, Converter={local:FriendlyDateConverter}, ConverterParameter=time}"
                                                   Margin="8,0,0,0"
                                                   Style="{StaticResource ClipListSecondaryTextBlock}" />
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Converter={local:ReasonLabelConverter}}"
                                                   Style="{StaticResource ClipListSecondaryTextBlock}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Converter={local:ClipDurationConverter}}"
                                                   Margin="8,0,0,0"
                                                   Style="{StaticResource ClipListTertiaryTextBlock}" />
                                    </Grid>

                                    <!--  Location: fixed-width pin column (clips the glyph's wide advance) + city with a small controlled gap.  -->
                                    <Grid Grid.Row="2"
                                          Margin="0,3,0,0"
                                          Visibility="{Binding Event, Converter={local:CityVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xECAF;"
                                                   Width="13"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Event.City}"
                                                   Margin="5,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource ClipListSecondaryTextBlock}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Event.City}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  Filtered-empty state (only while a search yields nothing)  -->
                <StackPanel Grid.Row="1"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Library.ClipCount}" Value="0" />
                                        <Condition Binding="{Binding Library.IsLoadingClips}" Value="False" />
                                        <Condition Binding="{Binding Library.HasFilterText}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE721;"
                               HorizontalAlignment="Center"
                               FontSize="28"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource AppGlyph}" />
                    <TextBlock Text="No clips match your search."
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource AppBody}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  Subtle animated loading bar shown while the clip list is (re)scanned  -->
                <ProgressBar Grid.Row="1"
                             Height="3"
                             Margin="4,0"
                             VerticalAlignment="Top"
                             Background="Transparent"
                             BorderThickness="0"
                             IsIndeterminate="True"
                             Visibility="{Binding Library.IsLoadingClips, Converter={local:BoolToVisibilityConverter}}" />

                <!--  Utility action bar (single row, divided from the list)  -->
                <Border Grid.Row="2"
                        Padding="12,10"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Command="{Binding Library.OpenFolderCommand}"
                                HorizontalContentAlignment="Left"
                                AutomationProperties.Name="Select folder"
                                Style="{StaticResource PressScaleButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;"
                                           Style="{StaticResource AppGlyphInButton}" />
                                <TextBlock Text="Select folder"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource AppBodyStrong}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding Library.RefreshClipsCommand}"
                                AutomationProperties.Name="Rescan folder"
                                Style="{StaticResource SubtleIconButton}"
                                ToolTip="Rescan the current folder for clips">
                            <TextBlock Text="&#xE72C;"
                                       Style="{StaticResource AppGlyph}" />
                        </Button>

                        <Grid Grid.Column="4">
                            <Button Command="{Binding ToggleAboutCommand}"
                                    AutomationProperties.Name="About and help"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="About / Help (F1)">
                                <TextBlock Text="&#xE946;"
                                           Style="{StaticResource AppGlyph}" />
                            </Button>
                            <Border Width="8"
                                    Height="8"
                                    Margin="0,4,4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource SystemFillColorAttentionBrush}"
                                    CornerRadius="4"
                                    IsHitTestVisible="False"
                                    ToolTip="Update available"
                                    Visibility="{Binding About.HasUpdateBadge, Converter={local:BoolToVisibilityConverter}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!--
                Splitter.
                Out of the tab order: the arrow keys that would move it seek the video instead, so as a tab stop it was an unnamed stop that did nothing.
            -->
            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Resize sidebar"
                          Background="Transparent"
                          IsTabStop="False" />

            <!--  Video Player Area (opaque: frames the native video surface)  -->
            <Grid Grid.Column="2"
                  Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Video Container  -->
                <Grid Grid.Row="0"
                      Margin="16,16,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="FlyleafHostPool"
                          Visibility="Collapsed">
                        <!--  KeyBindings=None: shortcuts are app-wide (Window_PreviewKeyDown acts on all cameras);
                              Flyleaf's per-surface key handling would pause/seek a single camera only.
                              Not focusable, like the slots they move between: they only show video, so as tab stops they were invisible, unnamed stops between the sidebar and the player controls.  -->
                        <fl:FlyleafHost x:Name="FrontFlyleafHost" Focusable="False" KeyBindings="None" />
                        <fl:FlyleafHost x:Name="BackFlyleafHost" Focusable="False" KeyBindings="None" />
                        <fl:FlyleafHost x:Name="LeftFlyleafHost" Focusable="False" KeyBindings="None" />
                        <fl:FlyleafHost x:Name="RightFlyleafHost" Focusable="False" KeyBindings="None" />
                        <fl:FlyleafHost x:Name="LeftPillarFlyleafHost" Focusable="False" KeyBindings="None" />
                        <fl:FlyleafHost x:Name="RightPillarFlyleafHost" Focusable="False" KeyBindings="None" />
                    </Grid>

                    <!--  Video Player  -->
                    <Grid Grid.RowSpan="2"
                          Visibility="{Binding ShowVideoHosts, Converter={local:BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            Focusable: keyboard focus is parked here after a camera-tile click so no control consumes keys ahead of the app-wide shortcuts.
                            Focusing the Window instead doesn't work because it's a focus scope, so WPF redirects to the last focused child (often a clip ListBoxItem, which swallows Space/arrows for list navigation).
                            It is no tab stop, though: Tab would land on it as an invisible, unnamed stop that does nothing.
                        -->
                        <Border x:Name="VideoContainer"
                                Grid.Row="0"
                                Background="Black"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="6"
                                Focusable="True"
                                KeyboardNavigation.IsTabStop="False">
                            <Grid>
                                <Grid Visibility="{Binding Cameras.IsGridViewSelected, Converter={local:BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,1,1"
                                            Background="Black"
                                            ClipToBounds="True">
                                        <Grid>
                                            <ContentControl x:Name="GridFrontHostSlot"
                                                            Focusable="False" />
                                            <Border Margin="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#A0000000"
                                                    CornerRadius="4">
                                                <TextBlock Text="Front"
                                                           FontSize="12"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="1,0,0,1"
                                            Background="Black"
                                            ClipToBounds="True">
                                        <Grid>
                                            <ContentControl x:Name="GridRearHostSlot"
                                                            Focusable="False" />
                                            <Border Margin="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#A0000000"
                                                    CornerRadius="4">
                                                <TextBlock Text="Rear"
                                                           FontSize="12"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,1,1,0"
                                            Background="Black"
                                            ClipToBounds="True">
                                        <Grid>
                                            <ContentControl x:Name="GridLeftHostSlot"
                                                            Focusable="False" />
                                            <Border Margin="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#A0000000"
                                                    CornerRadius="4">
                                                <TextBlock Text="Left"
                                                           FontSize="12"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="1,1,0,0"
                                            Background="Black"
                                            ClipToBounds="True">
                                        <Grid>
                                            <ContentControl x:Name="GridRightHostSlot"
                                                            Focusable="False" />
                                            <Border Margin="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#A0000000"
                                                    CornerRadius="4">
                                                <TextBlock Text="Right"
                                                           FontSize="12"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Visibility="{Binding Cameras.IsSingleCameraViewSelected, Converter={local:BoolToVisibilityConverter}}">
                                    <ContentControl x:Name="PrimaryCameraHostSlot"
                                                    Focusable="False" />
                                    <Border Margin="14"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Background="#A0000000"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding Cameras.ActiveCameraLabel}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Padding="5"
                                Background="{DynamicResource LayerFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <!--  One tile per view the current clip offers: the grid plus each recorded camera (four on HW3, six on HW4/AI4).
                                  Camera tiles carry a preview slot that registers itself with the code-behind (CameraTileSlot_Loaded), which re-parents each camera's Flyleaf host into it.  -->
                            <local:ControlGroupItemsControl AutomationProperties.Name="Camera views"
                                                            Focusable="False"
                                                            ItemsSource="{Binding Cameras.CameraViewOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CameraViewOption}">
                                        <local:CameraTileButton Command="{Binding DataContext.Cameras.SelectCameraViewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding ViewId}"
                                                                AutomationProperties.Name="{Binding AutomationName}"
                                                                GroupName="CameraViewMode"
                                                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                Style="{StaticResource CameraViewTileButton}"
                                                                ToolTip="{Binding ToolTip}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="64" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{Binding IsGrid, Converter={local:BoolToVisibilityConverter}}">
                                                    <TextBlock Text="&#xE80A;"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="34"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Style="{StaticResource AppGlyph}" />
                                                </Border>
                                                <Border Grid.Row="0"
                                                        Background="Black"
                                                        ClipToBounds="True"
                                                        CornerRadius="4"
                                                        Visibility="{Binding IsCamera, Converter={local:BoolToVisibilityConverter}}">
                                                    <Grid>
                                                        <ContentControl Focusable="False"
                                                                        Loaded="CameraTileSlot_Loaded" />
                                                        <!--  Single-screen icon: this camera is the main view (cf. the 2x2 grid icon)  -->
                                                        <Border Margin="18"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="3"
                                                                Visibility="{Binding IsSelected, Converter={local:BoolToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Label}"
                                                           Margin="0,6,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                        </local:CameraTileButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </local:ControlGroupItemsControl>
                        </Border>
                    </Grid>

                    <!--  Status Overlay (Loading/Rendering/Error)  -->
                    <Border Grid.RowSpan="2"
                            Background="#80000000"
                            Visibility="{Binding ShowStatusOverlay, Converter={local:BoolToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowStatusOverlay}"
                                                 Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0"
                                                                     To="1"
                                                                     Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel MaxWidth="500"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <!--  Idle: clips are loaded but none is picked yet  -->
                            <StackPanel Visibility="{Binding HasNoClipSelected, Converter={local:BoolToVisibilityConverter}}">
                                <TextBlock Text="&#xE714;"
                                           FontSize="40"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Style="{StaticResource AppGlyph}" />
                                <TextBlock Text="Select a clip to begin"
                                           Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource AppSubtitle}" />
                                <TextBlock Text="Your dashcam timeline is on the left."
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Style="{StaticResource AppBody}" />
                            </StackPanel>

                            <!--  Loading / rendering status  -->
                            <StackPanel Visibility="{Binding IsLoading, Converter={local:BoolToVisibilityConverter}}">
                                <TextBlock Text="Loading..."
                                           Margin="0,0,0,16"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Style="{StaticResource AppSubtitle}" />
                                <ProgressBar Width="300"
                                             Height="6"
                                             IsIndeterminate="True" />
                            </StackPanel>

                            <!--  Error / first-run empty state  -->
                            <StackPanel Visibility="{Binding Error.IsVisible, Converter={local:BoolToVisibilityConverter}}">
                                <Border Width="64"
                                        Height="64"
                                        Margin="0,0,0,16"
                                        HorizontalAlignment="Center"
                                        CornerRadius="32">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Error.IsEmptyState}"
                                                             Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="26">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource AppGlyph}">
                                                <Setter Property="Text" Value="&#xE783;" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Error.IsEmptyState}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="&#xE8B7;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Error.Title}"
                                           Margin="0,0,0,8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource AppSubtitle}">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Error.IsEmptyState}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Error.Details}"
                                           MaxWidth="380"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource AppBody}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button Content="Select folder"
                                        Command="{Binding Library.OpenFolderCommand}"
                                        Margin="0,20,0,0"
                                        Padding="24,8"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{Binding Error.IsEmptyState, Converter={local:BoolToVisibilityConverter}}" />
                                <Button Content="Download FFmpeg"
                                        Command="{Binding DownloadFFmpegCommand}"
                                        Margin="0,20,0,0"
                                        Padding="24,8"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Visibility="{Binding Error.ShowFFmpegDownloadButton, Converter={local:BoolToVisibilityConverter}}" />
                                <Button Content="Dismiss"
                                        Command="{Binding Error.DismissCommand}"
                                        Margin="0,12,0,0"
                                        Padding="24,8"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        Visibility="{Binding Error.CanDismiss, Converter={local:BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1">
                    <!--
                        Export progress: FFmpeg can take a while on a slow drive, and nothing else in the window changes while it runs.
                        Cancel stops FFmpeg and deletes the unfinished file.
                    -->
                    <Border Padding="16,8"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding Trim.IsExporting, Converter={local:BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressBar Width="48"
                                         Margin="0,0,12,0"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Exporting"
                                         IsIndeterminate="True" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Trim.ExportProgressText}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="2"
                                    Content="Cancel export"
                                    Command="{Binding Trim.CancelExportCommand}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DefaultButtonStyle}" />
                        </Grid>
                    </Border>

                    <!--  Export confirmation: the Explorer window an export opens can land on another monitor, so the app says itself that the file was saved.  -->
                    <Border Padding="16,8"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding Trim.HasSavedExport, Converter={local:BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="&#xE73E;"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       Style="{StaticResource AppGlyph}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Trim.SavedExportText}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding Trim.SavedExportPath}" />
                            <Button Grid.Column="2"
                                    Content="Show in folder"
                                    Command="{Binding Trim.ShowSavedExportCommand}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DefaultButtonStyle}" />
                            <Button Grid.Column="3"
                                    Content="Dismiss"
                                    Command="{Binding Trim.DismissExportNoticeCommand}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Dismiss export confirmation"
                                    Style="{StaticResource DefaultButtonStyle}" />
                        </Grid>
                    </Border>

                    <!--
                        Export notice: why the last export didn't happen.
                        It lives here, not in the status overlay, because the overlay can't draw over the native video surface and would hide a clip that is still playing.
                    -->
                    <Border Padding="16,8"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding Trim.HasExportNotice, Converter={local:BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="&#xE783;"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Style="{StaticResource AppGlyph}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Trim.ExportNotice}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="2"
                                    Content="Dismiss"
                                    Command="{Binding Trim.DismissExportNoticeCommand}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Dismiss export notice"
                                    Style="{StaticResource DefaultButtonStyle}" />
                        </Grid>
                    </Border>

                    <!--
                        Trim panel: appears above the player controls while cutting a range.
                        Deliberately wordy, with labeled steps plus a hint line that walks through start → end → export, so the feature needs no manual.
                        All state lives in the view-model (IsTrimming plus the selection marks); closing always discards the marks.
                    -->
                    <Border Padding="16,10"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,1"
                            Visibility="{Binding Trim.IsTrimming, Converter={local:BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,14,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <TextBlock Text="&#xE8C6;"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource AppGlyph}" />
                                <TextBlock Text="Trim clip"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding Trim.MarkSelectionStartCommand}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Set start"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    ToolTip="Mark the start of the cut at the playhead (I)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="["
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Set start"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding Trim.MarkSelectionEndCommand}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Set end"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    ToolTip="Mark the end of the cut at the playhead (O)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="]"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Set end"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!--
                                Live guidance: which step is next, then the selected length.
                                It wraps rather than trims, because at common laptop widths a single line cut off the step's last words, the part that says what to do.
                            -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Trim.TrimHintText}"
                                       Margin="16,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <Button Grid.Column="4"
                                    Command="{Binding Trim.ExportSelectionCommand}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Export trimmed clip"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTip="Save the marked section as an MP4 — lossless and instant (Ctrl+E)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE792;"
                                               Style="{StaticResource AppGlyphInButton}" />
                                    <TextBlock Text="Export…"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="5"
                                    Content="Cancel"
                                    Command="{Binding Trim.CancelTrimCommand}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Cancel trim"
                                    Style="{StaticResource DefaultButtonStyle}"
                                    ToolTip="Close and discard the marks (Esc)" />
                        </Grid>
                    </Border>

                    <!--  Player Controls: transport · event/trim · scrubber · time · speed, one row  -->
                    <Border Padding="16,10"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Transport cluster  -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Command="{Binding Playback.PreviousCommand}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Previous clip"
                                    IsEnabled="{Binding Playback.CanGoPrevious}"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Previous clip (Ctrl+Left)">
                                <TextBlock Text="&#xE892;"
                                           Style="{StaticResource AppGlyph}" />
                            </Button>

                            <Button Command="{Binding Playback.StepFrameBackwardCommand}"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Previous frame"
                                    IsEnabled="{Binding Playback.CanSeek}"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Previous frame (,)">
                                <TextBlock Text="&#xE76B;"
                                           Style="{StaticResource AppGlyph}" />
                            </Button>

                            <Button x:Name="PlayPauseButton"
                                    Content="{Binding Playback.PlayPauseIcon}"
                                    Command="{Binding Playback.PlayPauseCommand}"
                                    Width="56"
                                    Height="40"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                    FontSize="20"
                                    AutomationProperties.Name="{Binding Playback.IsPlaying, Converter={local:BoolToTextConverter}, ConverterParameter='Pause|Play'}"
                                    IsEnabled="{Binding Playback.CanPlayPause}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTip="{Binding Playback.IsPlaying, Converter={local:BoolToTextConverter}, ConverterParameter='Pause (Space)|Play (Space)'}" />

                            <Button Command="{Binding Playback.StepFrameForwardCommand}"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Next frame"
                                    IsEnabled="{Binding Playback.CanSeek}"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Next frame (.)">
                                <TextBlock Text="&#xE76C;"
                                           Style="{StaticResource AppGlyph}" />
                            </Button>

                            <Button Command="{Binding Playback.NextCommand}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Next clip"
                                    IsEnabled="{Binding Playback.CanGoNext}"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Next clip (Ctrl+Right)">
                                <TextBlock Text="&#xE893;"
                                           Style="{StaticResource AppGlyph}" />
                            </Button>

                            <Button Command="{Binding Playback.StopCommand}"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Stop"
                                    IsEnabled="{Binding Playback.CanStop}"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Stop">
                                <TextBlock Text="&#xE71A;"
                                           Style="{StaticResource AppGlyph}" />
                            </Button>
                        </StackPanel>

                        <!--
                            Event + Trim cluster. Unlike the transport icons (universal player
                            symbols), these two are app-specific actions, so they carry text
                            labels; a divider separates them from the transport cluster.
                        -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Rectangle Width="1"
                                       Height="24"
                                       Margin="14,0,4,0"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <!--  Jump straight to the moment the incident happened  -->
                            <Button Command="{Binding Playback.JumpToEventCommand}"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Jump to event"
                                    IsEnabled="{Binding Playback.HasEventMarker}"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Jump to the moment the event fired (E)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C1;"
                                               Style="{StaticResource AppGlyphInButton}" />
                                    <TextBlock Text="Event"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!--
                                Opens the trim panel (above this bar) for cutting a shareable MP4.
                                A toggle so screen readers can tell whether the panel is open; it keeps the flat button look, since the open panel already shows that on screen.
                            -->
                            <local:CommandToggleButton Command="{Binding Trim.ToggleTrimmingCommand}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.Name="Trim clip"
                                                       IsChecked="{Binding Trim.IsTrimming, Mode=OneWay}"
                                                       Style="{StaticResource SubtleIconButton}"
                                                       ToolTip="Cut a section of this clip to share (I / O to mark)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C6;"
                                               Style="{StaticResource AppGlyphInButton}" />
                                    <TextBlock Text="Trim"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </local:CommandToggleButton>
                        </StackPanel>

                        <!--
                            Scrubber (carries the event marker + chunk seams).
                            Its own value is a 0..1 fraction, so its item status carries the time for screen readers.
                        -->
                        <Slider x:Name="SeekSlider"
                                Grid.Column="2"
                                Margin="16,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Seek"
                                IsEnabled="{Binding Playback.CanSeek}"
                                Maximum="1"
                                Minimum="0"
                                Style="{StaticResource SeekSlider}"
                                ValueChanged="SeekSlider_ValueChanged"
                                Value="{Binding Playback.SeekPosition, Mode=TwoWay}">
                            <AutomationProperties.ItemStatus>
                                <MultiBinding StringFormat="{}{0} of {1}">
                                    <Binding Path="Playback.PositionText" />
                                    <Binding Path="Playback.DurationText" />
                                </MultiBinding>
                            </AutomationProperties.ItemStatus>
                        </Slider>

                        <!--
                            Time readout.
                            Its minimum width fits the longest time the open clip can show, so the seek bar and its markers don't shift each time the position gains a digit (crossing 10:00), while a clip under 10 minutes doesn't give up seek bar width to digits it never shows.
                            Right-aligned, so the duration stays put and only the position grows.
                        -->
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="13"
                                   TextAlignment="Right">
                            <TextBlock.MinWidth>
                                <MultiBinding Converter="{local:TimeReadoutWidthConverter}">
                                    <Binding Path="Playback.DurationText" />
                                    <Binding RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </TextBlock.MinWidth>
                            <Run Text="{Binding Playback.PositionText, Mode=OneWay}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Run Text=" / "
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding Playback.DurationText, Mode=OneWay}"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>

                        <!--  Playback speed stepper: walks a fixed ladder (0.25x to 16x, Flyleaf's ceiling)
                              instead of listing every speed in a dropdown. Click the readout to reset to 1x.  -->
                        <StackPanel Grid.Column="4"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button Command="{Binding Playback.DecreaseSpeedCommand}"
                                    AutomationProperties.Name="Slower"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Slower (Shift+,)">
                                <TextBlock Text="&#xE738;"
                                           FontSize="13"
                                           Style="{StaticResource AppGlyph}" />
                            </Button>
                            <Button MinWidth="72"
                                    Command="{Binding Playback.ResetSpeedCommand}"
                                    AutomationProperties.Name="{Binding Playback.PlaybackSpeedText, StringFormat='Playback speed {0}'}"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Playback speed — click to reset to 1x">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC57;"
                                               FontSize="15"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource AppGlyphInButton}" />
                                    <TextBlock Text="{Binding Playback.PlaybackSpeedText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding Playback.IncreaseSpeedCommand}"
                                    AutomationProperties.Name="Faster"
                                    Style="{StaticResource SubtleIconButton}"
                                    ToolTip="Faster (Shift+.)">
                                <TextBlock Text="&#xE710;"
                                           FontSize="13"
                                           Style="{StaticResource AppGlyph}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              Visibility="{Binding ShowAboutPage, Converter={local:BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="16,12"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Command="{Binding ToggleAboutCommand}"
                            AutomationProperties.Name="Back to player"
                            Style="{StaticResource SubtleIconButton}"
                            ToolTip="Back to player (Esc)">
                        <TextBlock Text="&#xE72B;"
                                   Style="{StaticResource AppGlyph}" />
                    </Button>
                    <TextBlock Text="About / Help"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Style="{StaticResource AppTitle}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="24"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <!--  App identity  -->
                            <StackPanel Orientation="Horizontal">
                                <Image Width="52"
                                       Height="52"
                                       Source="{StaticResource AppIconImage}" />
                                <StackPanel Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Sentry Deck"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="Version" />
                                        <Run Text="{Binding About.FileVersion, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Review TeslaCam footage in a single timeline with easy clip navigation."
                                       Margin="0,16,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <!--  Quick start  -->
                            <TextBlock Text="Quick start"
                                       Style="{StaticResource AboutSectionHeader}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="Select folder"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Run Text="to pick your TeslaCam directory — USB drives are found automatically." />
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="Choose a clip" />
                                    <Run Text="from the timeline on the left to start playback." />
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="12">
                                    <TextBlock Text="3"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="Scrub and switch cameras" />
                                    <Run Text="with the controls below the video, or click any camera to enlarge it." />
                                </TextBlock>
                            </Grid>

                            <!--  Keyboard shortcuts  -->
                            <TextBlock Text="Keyboard shortcuts"
                                       Style="{StaticResource AboutSectionHeader}" />
                            <StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="Space" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Play / pause" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="&#x2190; / &#x2192;" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Seek 5 seconds" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="&#x2190; / &#x2192;" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Previous / next clip" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="F" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Focus search (also F3 or F6)" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="," Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="." Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Step one frame back / forward" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="Shift" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text=", / ." Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Slower / faster playback" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="E" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Jump to the event moment" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="1 – 7" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Switch camera view (one key per tile, also on the numpad)" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="I" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="O" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Mark the trim start / end" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="Ctrl" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="E" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Export the trimmed section as MP4" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8"
                                            Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="Esc" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Cancel the trim" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="F1" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <Border Style="{StaticResource Keycap}">
                                        <TextBlock Text="Esc" Style="{StaticResource KeycapText}" />
                                    </Border>
                                    <TextBlock Text="Open / close this help page" Style="{StaticResource AboutShortcutLabel}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Playback notes  -->
                            <TextBlock Text="Playback notes"
                                       Style="{StaticResource AboutSectionHeader}" />
                            <TextBlock Text="FFmpeg 9.0 shared binaries are required for playback. Use the Download FFmpeg button when prompted."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="If clips do not appear, confirm the folder contains a TeslaCam directory."
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0">
                        <Border Padding="20"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="App info"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Grid Margin="0,8,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="12"
                                            Height="12"
                                            Margin="0,4,0,0"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="6"
                                            Visibility="{Binding About.HasUpdateBadge, Converter={local:BoolToVisibilityConverter}}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding About.UpdateStatusTitle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextControlForeground}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextControlForeground}"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding About.UpdateStatusDetails, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Hyperlink NavigateUri="{Binding About.LatestReleaseUrl}"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                Learn more
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Version:"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextControlPlaceholderForeground}"
                                               TextAlignment="Right" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Text="{Binding About.FileVersion}"
                                               Foreground="{DynamicResource TextControlForeground}" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Runtime:"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextControlPlaceholderForeground}"
                                               TextAlignment="Right" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="2"
                                               Text="{Binding About.RuntimeDescription}"
                                               Foreground="{DynamicResource TextControlForeground}" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="OS:"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextControlPlaceholderForeground}"
                                               TextAlignment="Right" />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="2"
                                               Text="{Binding About.OsDescription}"
                                               Foreground="{DynamicResource TextControlForeground}" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Text="Exe:"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextControlPlaceholderForeground}"
                                               TextAlignment="Right" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="2"
                                               Text="{Binding About.ExecutablePath}"
                                               Foreground="{DynamicResource TextControlForeground}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="20"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Support"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextControlForeground}" />
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Margin="0,0,0,8">
                                        <Hyperlink NavigateUri="https://github.com/danielchalmers/SentryDeck"
                                                   RequestNavigate="Hyperlink_RequestNavigate">
                                            <Run Text="&#xE8A7;"
                                                 FontFamily="{DynamicResource SymbolThemeFontFamily}" />
                                            <Run Text="  View Sentry Deck on GitHub" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,8">
                                        <Hyperlink NavigateUri="https://github.com/danielchalmers/SentryDeck/issues"
                                                   RequestNavigate="Hyperlink_RequestNavigate">
                                            <Run Text="&#xEBE8;"
                                                 FontFamily="{DynamicResource SymbolThemeFontFamily}" />
                                            <Run Text="  Report a bug / request a feature" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="20"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="More from the author"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextControlForeground}" />
                                <UniformGrid Columns="3"
                                             Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource ProjectTitleTextBlock}">
                                            <Hyperlink NavigateUri="https://github.com/danielchalmers/JournalApp"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                Good Diary
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="Track your daily activities and moods on Android."
                                                   Margin="0,4,0,8"
                                                   Style="{StaticResource ProjectDescriptionTextBlock}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource ProjectTitleTextBlock}">
                                            <Hyperlink NavigateUri="https://github.com/danielchalmers/DesktopClock"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                DesktopClock
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="A digital clock for your desktop."
                                                   Margin="0,4,0,8"
                                                   Style="{StaticResource ProjectDescriptionTextBlock}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource ProjectTitleTextBlock}">
                                            <Hyperlink NavigateUri="https://github.com/danielchalmers/RadialActions"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                Radial Actions
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="Summon a customizable menu at your cursor."
                                                   Margin="0,4,0,8"
                                                   Style="{StaticResource ProjectDescriptionTextBlock}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource ProjectTitleTextBlock}">
                                            <Hyperlink NavigateUri="https://github.com/danielchalmers/SteamAccountSwitcher"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                SteamAccountSwitcher
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="Swap Steam accounts from the system tray."
                                                   Margin="0,4,0,8"
                                                   Style="{StaticResource ProjectDescriptionTextBlock}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource ProjectTitleTextBlock}">
                                            <Hyperlink NavigateUri="https://github.com/danielchalmers/Network-Monitor"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                Network Monitor
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="Live latency and bandwidth in a desktop widget."
                                                   Margin="0,4,0,8"
                                                   Style="{StaticResource ProjectDescriptionTextBlock}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource ProjectTitleTextBlock}">
                                            <Hyperlink NavigateUri="https://github.com/danielchalmers/Teichos"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                Teichos
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="Stay focused with URL blocking and schedules."
                                                   Margin="0,4,0,8"
                                                   Style="{StaticResource ProjectDescriptionTextBlock}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource ProjectTitleTextBlock}">
                                            <Hyperlink NavigateUri="https://github.com/danielchalmers/Nuntia"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                Nuntia
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="Generate release notes with AI."
                                                   Margin="0,4,0,8"
                                                   Style="{StaticResource ProjectDescriptionTextBlock}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource ProjectTitleTextBlock}">
                                            <Hyperlink NavigateUri="https://github.com/danielchalmers/Dayboard"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                Dayboard
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="Countdowns and clocks on your browser's new tab."
                                                   Margin="0,4,0,8"
                                                   Style="{StaticResource ProjectDescriptionTextBlock}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource ProjectTitleTextBlock}">
                                            <Hyperlink NavigateUri="https://github.com/danielchalmers/AutoTriage"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                                AutoTriage
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="Triage GitHub issues and PRs with AI."
                                                   Margin="0,4,0,8"
                                                   Style="{StaticResource ProjectDescriptionTextBlock}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Margin="0,0,0,8">
                                    <Hyperlink NavigateUri="https://github.com/danielchalmers"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        View all projects on GitHub
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
